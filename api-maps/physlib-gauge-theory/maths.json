{
  "SU(3) × SU(2) × U(1)": "\\mathrm{SU}(3) \\times \\mathrm{SU}(2) \\times \\mathrm{U}(1)",
  "U(1)": "\\mathrm{U}(1)",
  "U ∈ G_J": "U \\in G_J",
  "a ∈ 𝔤_J": "a \\in \\mathfrak{g}_J",
  "A_μ ↦ Ad_U A_μ + θ_μ(U)": "A_\\mu \\mapsto \\operatorname{Ad}_U A_\\mu + \\theta_\\mu(U)",
  "U A_μ U⁻¹": "U A_\\mu U^{-1}",
  "θ_μ(U) = i (∂_μ U) U⁻¹": "\\theta_\\mu(U) = i (\\partial_\\mu U) U^{-1}",
  "F_μν = ∂_μ A_ν − ∂_ν A_μ + ⁅A_μ, A_ν⁆": "F_{\\mu\\nu} = \\partial_\\mu A_\\nu - \\partial_\\nu A_\\mu + [A_\\mu, A_\\nu]",
  "⁅A, B⁆ = i (AB − BA)": "[A, B] = i (AB - BA)",
  "U(x) ∈ G": "U(x) \\in G",
  "a(x) ∈ 𝔤": "a(x) \\in \\mathfrak{g}",
  "g ∈ G": "g \\in G",
  "c ∈ 𝔤": "c \\in \\mathfrak{g}",
  "∂_μ ⁅a, b⁆ = ⁅∂_μ a, b⁆ + ⁅a, ∂_μ b⁆": "\\partial_\\mu [a, b] = [\\partial_\\mu a, b] + [a, \\partial_\\mu b]",
  "∂_μ (x_ν a) = x_ν ∂_μ a + δ_μν a": "\\partial_\\mu (x_\\nu a) = x_\\nu \\partial_\\mu a + \\delta_{\\mu\\nu} a",
  "θ_μ(UV) = θ_μ(U) + Ad_U θ_μ(V)": "\\theta_\\mu(UV) = \\theta_\\mu(U) + \\operatorname{Ad}_U \\theta_\\mu(V)",
  "∂_μ θ_ν(U) − ∂_ν θ_μ(U) + ⁅θ_μ(U), θ_ν(U)⁆ = 0": "\\partial_\\mu \\theta_\\nu(U) - \\partial_\\nu \\theta_\\mu(U) + [\\theta_\\mu(U), \\theta_\\nu(U)] = 0",
  "G_J → G": "G_J \\to G",
  "G → G_J": "G \\to G_J",
  "𝔤_J → 𝔤": "\\mathfrak{g}_J \\to \\mathfrak{g}",
  "𝔤 → 𝔤_J": "\\mathfrak{g} \\to \\mathfrak{g}_J",
  "∂_(s + t) = ∂_s ∂_t": "\\partial_{s + t} = \\partial_s \\partial_t",
  "∂_s ⁅a, b⁆ = Σ ⁅∂_s₁ a, ∂_s₂ b⁆": "\\partial_s [a, b] = \\sum [\\partial_{s_1}a, \\partial_{s_2}b]",
  "s₁ + s₂": "s_1 + s_2",
  "∂_s c = 0": "\\partial_s c = 0",
  "(∂_s (x_μ a))(x)": "(\\partial_s (x_\\mu a))(x)",
  "(∂_(s − μ) a)(x)": "(\\partial_{s - \\mu}a)(x)",
  "G → G'": "G \\to G'",
  "𝔤 → 𝔤'": "\\mathfrak{g} \\to \\mathfrak{g}'",
  "G_J → G'_J": "G_J \\to G'_J",
  "𝔤_J → 𝔤'_J": "\\mathfrak{g}_J \\to \\mathfrak{g}'_J",
  "Ad_U": "\\operatorname{Ad}_U",
  "Ad_g": "\\operatorname{Ad}_g",
  "A_μ": "A_\\mu",
  "x_μ": "x_\\mu",
  "∂_μ": "\\partial_\\mu",
  "∂_s": "\\partial_s",
  "𝔤_J": "\\mathfrak{g}_J",
  "G_J": "G_J",
  "𝔤'": "\\mathfrak{g}'",
  "𝔤": "\\mathfrak{g}",
  "ℝ": "\\mathbb{R}"
}
