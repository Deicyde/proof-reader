[paper]
title = ""
short_title = ""
authors = []
venue = ""
doi = ""
url = ""
pdf = "paper.pdf"
# Show Proof Reader's own explainer films in the header and on the first screen.
# films = true
# For an author's Markdown guide, replace pdf above with:
# markdown = "guide.md"
# Set url to the source file so its relative links keep their destination.
# What the page calls the authors' text, when it is not a paper:
# noun = "guide"
pdf_source = ""
licence = ""
licence_url = ""

# Optional exact credit for a Markdown source.
# [credit]
# text = "Text: Author, repository at COMMIT, Apache-2.0"

[lean]
project = "lean"
modules = []
source = ""
source_name = ""
# Where one declaration's lines can be read, when the artifact has such a link:
# source_lines = "https://github.com/owner/repo/blob/COMMIT/{path}#L{line}-L{end}"
licence = ""
scope = ""

# The reading copy. Delete this part until the paper has a paper.md.
[reading]
language = "haskell"          # the language of the paper's code listings
page_label = "{page}"         # how the paper numbers its pages, such as "191:{page}"

# Plots stay the authors' own: each is cut from the PDF as vector artwork, and the
# words inside it are left out of the text comparison. The box is in PDF points.
# [[reading.figure]]
# name = "fig-3.svg"
# page = 11
# box = [50, 84, 432, 210]

# The front page shows linked sentences beside their Lean lines. Name one passage id
# from links.json, or a list of ids in the order the front page should show them. A
# name that is not a passage, a passage with no Lean declaration, or a name given twice
# stops the build. Leave it out and the front page shows no example.
# [shelf]
# example = "isoR-clam"
# or
# example = ["isoR-clam", "closed-world", "indexIsoL"]
